{
  "name": "game-control-plane",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "build:api": "pnpm generate && pnpm --filter @game-studio/api build",
    "build:web": "pnpm generate && pnpm --filter @game-studio/web build",
    "start:api": "pnpm --filter @game-studio/api start",
    "start:web": "pnpm --filter @game-studio/web start",
    "clean": "turbo clean",
    "generate:agents": "pnpm --filter @game-studio/agents run generate",
    "generate:skills": "pnpm --filter @game-studio/skills run generate",
    "generate": "pnpm generate:agents && pnpm generate:skills"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.13.5",
    "dotenv": "^16.4.7",
    "playwright": "^1.60.0",
    "turbo": "^2.9.18",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "vitest": "^3.2.6",
      "vite": "^6.4.3",
      "postcss": "^8.5.15",
      "qs": "^6.15.2",
      "tar": "^7.5.16",
      "esbuild": "^0.28.1"
    }
  }
}
