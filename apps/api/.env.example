# =============================================================================
# API server — environment template (run from apps/api or repo root)
# Copy to apps/api/.env OR repo root .env (dotenv loads from cwd).
# =============================================================================

# --- Z.ai / GLM (default provider) ---
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai/api/anthropic

# --- Kimi (optional — Moonshot / UCWS sponsor) ---
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding

# Model tiers (agent prompts map opus/sonnet/haiku → models in model-mapping.ts):
#   GLM:  glm-5.1 (opus), glm-4.7 (sonnet), glm-4.7-flash (haiku)
#   Kimi: kimi-for-coding, kimi-k2.6, kimi-k2.5, kimi-k2-turbo-preview
DEFAULT_MODEL=glm-5.1

API_PORT=3001
API_SECRET=your_random_secret_here

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_API_KEY=your_random_secret_here

# Path relative to apps/api when running pnpm --filter @game-studio/api dev
WORKSPACE_DIR=../../workspace

REVIEW_MODE=lean
MAX_TOOL_CALLS=100
TOOL_CHECKPOINT_INTERVAL=30
