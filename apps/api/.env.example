# API Keys
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai/api/anthropic

# API Server
API_PORT=3001
API_SECRET=your_random_secret_here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Workspace (game development directory - path relative to apps/api)
WORKSPACE_DIR=../../workspace

# Review Mode (solo | lean | full)
REVIEW_MODE=lean

# Agent Configuration
# Model tiers are automatically mapped:
#   opus   -> glm-5.1       (most capable, for Tier 1 directors)
#   sonnet -> glm-4.7       (balanced, for Tier 2 leads)
#   haiku  -> glm-4.7-flash (fast, for Tier 3 specialists)
DEFAULT_MODEL=glm-5.1
MAX_TOOL_CALLS=100
TOOL_CHECKPOINT_INTERVAL=30
