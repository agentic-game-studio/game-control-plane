# =============================================================================
# Game Studio Control Plane — environment template
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider (choose one primary path)
# -----------------------------------------------------------------------------

# --- Option A: Z.ai / GLM (default) ---
# Optional if KIMI_API_KEY is set. Get a key from https://z.ai
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/anthropic

# --- Option B: Kimi (Moonshot AI — UCWS sponsor) ---
# Optional if ZAI_API_KEY is set. When this is the only key, tiers auto-route to Kimi.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding

# --- Option C: MiroMind (Deep Research) ---
# Specialised deep research model for market analysis, competitive landscape,
# genre trends, and audience profiling. Used for pre-GDD research phase.
MIROMIND_API_KEY=
MIROMIND_BASE_URL=https://api.miromind.ai
MIROMIND_MODEL=mirothinker-1-7-deepresearch-mini

# Fallback model when a request does not specify tier (must match your provider):
#   GLM:  glm-5.1 | glm-4.7 | glm-4.7-flash
#   Kimi: kimi-for-coding | kimi-k2.6 | kimi-k2.5 | kimi-k2-turbo-preview
DEFAULT_MODEL=glm-5.1

# Optional: override context window (tokens) for all models
# CONTEXT_WINDOW_TOKENS=256000

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
API_PORT=3001
# Min 16 characters — used for REST + WebSocket auth (x-api-key / ?apiKey=)
API_SECRET=change_this_to_a_random_secret

# CORS — single origin or comma-separated list of allowed origins.
# Example for multiple dev origins: CORS_ORIGIN=http://localhost:3000,http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Max request body size in MB (default 5). Individual upload routes (assets,
# thumbnails) may attach their own parser with a higher limit.
# BODY_LIMIT_MB=5

# Max time for a single LLM call in ms (default 120000 = 2 minutes).
# API_TIMEOUT_MS=120000

# Set to "true" to enable test-only endpoints in chat.ts (consultation/test-create).
# Must NEVER be set in production. The Zod schema accepts only "true"
# or "false" (case-sensitive); "1" / "yes" / "on" will be rejected at boot.
# ENABLE_TEST_ENDPOINTS=false

# -----------------------------------------------------------------------------
# Frontend (must match API_SECRET in dev)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_API_KEY=change_this_to_a_random_secret

# -----------------------------------------------------------------------------
# Workspace & orchestration
# -----------------------------------------------------------------------------
WORKSPACE_DIR=./workspace
REVIEW_MODE=lean
MAX_TOOL_CALLS=100
TOOL_CHECKPOINT_INTERVAL=30

# Cap on concurrent subagents per project (default: 8). Useful to limit
# cost / parallelism on shared infrastructure.
# MAX_CONCURRENT_SUBAGENTS_PER_PROJECT=8

# Max verification failures per ticket before it's moved to the dead-letter
# column (default: 3). Prevents infinite verify→fix→verify loops that burn
# LLM credits when a ticket cannot be satisfied.
# 29-L-env-example-uncomment-verify: previous shape had the two
# caps commented out even though config.ts reads them. An operator
# looking at .env.example to understand what knobs are available
# would not see these — they'd flip the schema in a future commit
# and break every deploy that was actually trying to tune them.
# Leave them uncommented so they're discoverable; the leading
# `# value` form (commented value) shows the default.
MAX_VERIFY_FAILURES=3

# Cap on dead-lettered tickets per project (default: 50). Older entries
# get evicted in FIFO order so the column can't grow unbounded.
MAX_DEAD_LETTERED_PER_PROJECT=50

# Express trust-proxy setting. Required when behind a reverse proxy
# (Railway, nginx, Cloudflare) so req.ip honors X-Forwarded-For and the
# rate limiter sees real client addresses. Accepts: "false" (default),
# "true", a hop count, or a CIDR. Only enable when you control the
# proxy chain — otherwise IPs can be spoofed.
# TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Rate limiting (per-route buckets for autonomous / teams / assets-generate)
# -----------------------------------------------------------------------------
# Max requests allowed in the rolling window below.
# RATE_LIMIT_REQUESTS=10
# Rolling window in ms (default 60000 = 1 minute).
# RATE_LIMIT_WINDOW_MS=60000
# Cap on the number of distinct client buckets tracked (prevents unbounded
# Map growth if many distinct IPs hit the server).
# RATE_LIMIT_BUCKET_CAP=10000

# -----------------------------------------------------------------------------
# Workflow + document watcher tunables
# -----------------------------------------------------------------------------
# Time-to-live (ms) for an in-flight quest-bridge workflow before cleanup
# considers it stale (default 24h).
# WORKFLOW_TTL_MS=86400000
# Max in-flight document watcher entries before eviction (default 32).
# ASSET_WATCHER_LIMIT=32

# -----------------------------------------------------------------------------
# Server limits
# -----------------------------------------------------------------------------
# Hard cap on concurrent SSE log-streaming clients (default 50). New
# connections beyond this return 503.
# MAX_SSE_CLIENTS=50

# -----------------------------------------------------------------------------
# Debug / observability
# -----------------------------------------------------------------------------
# Set to "1" to enable the autonomous-loop debug log (writes a per-iteration
# line to <WORKSPACE_DIR>/production/logs/autonomous-debug.txt, rotating
# at 5MB). Off by default — the log grows quickly under load.
# DEBUG_AUTONOMOUS=1

# Set to "false" to disable file-based logs (api.log, error.log). File logs
# are also auto-disabled when RAILWAY_ENVIRONMENT_ID is set, since Railway
# captures stdout/stderr.
# LOG_TO_FILE=true

# -----------------------------------------------------------------------------
# Optional: Godot / assets / release
# -----------------------------------------------------------------------------
# GODOT_BIN=~/.local/bin/godot_bin/Godot
# GODOT_MCP_SERVER_PATH=...
# PIPELINE_PYTHON=/usr/local/bin/python3
# SHIPTHIS_CLI_PATH=...
# SHIPTHIS_BIN=...
