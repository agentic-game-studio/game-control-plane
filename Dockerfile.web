# syntax=docker/dockerfile:1.7

# ---------- deps stage ----------
# Pre-install dependencies in a separate stage so the (slow) pnpm install
# cache survives source-only rebuilds. NODE_ENV=development here so devDeps
# (e.g. typescript, tailwind) are available for the build step.
FROM node:22.12.0-bookworm-slim AS deps
WORKDIR /app

ENV COREPACK_ENABLE_STRICT=0

RUN corepack enable

# Copy lockfile + workspace manifest first for the best layer cache
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
# Source for package.json discovery (pnpm needs each workspace package.json)
COPY apps ./apps
COPY packages ./packages

RUN NODE_ENV=development pnpm install --frozen-lockfile

# ---------- build stage ----------
FROM deps AS build
ENV NODE_ENV=production

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_API_KEY

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_API_KEY=$NEXT_PUBLIC_API_KEY

# next build needs the source; pnpm build:web runs the Next.js build.
# The /workspace volume (if mounted at runtime) is not used here.
RUN pnpm build:web

# ---------- runtime stage ----------
# Slim runtime, non-root, distroless-ish. The Next.js standalone build
# (apps/web/.next/standalone) already has its own server.js; we copy only
# what's needed.
FROM node:22.12.0-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV COREPACK_ENABLE_STRICT=0

# Bring the built app + node_modules. We copy from the build stage's
# pnpm store cache path implicitly by re-installing with --offline.
# 10-M9: chown at COPY time so the runtime `node` user can write
# Next.js cache, .next/trace, and any file under .next/. Without this,
# the COPY above left everything root-owned and the standalone server
# crashed at first request when it tried to open a write fd.
COPY --from=build --chown=node:node /app/apps ./apps
COPY --from=build --chown=node:node /app/packages ./packages
# All sources as absolute paths. Relative paths after `--from=build`
# resolve against the build stage's WORKDIR, which BuildKit does not
# reliably carry across `FROM <prev> AS <new>` boundaries. Absolute
# paths sidestep the lookup and match what the runtime stage expects.
COPY --from=build --chown=node:node /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml /app/turbo.json ./

# Re-install in production mode (drops devDeps) using the cached store.
RUN corepack enable \
    && pnpm install --frozen-lockfile --prod \
    && chown -R node:node /app

# Next.js standalone needs .next/static served from the project root at
# runtime. We pre-bake it into the image so the container needs no
# external volume to serve the app. (No public/ dir to copy — the web
# app doesn't ship static assets, and a missing COPY source is a hard
# build failure under BuildKit. Add the COPY back when a public/ exists.)
COPY --from=build --chown=node:node /app/apps/web/.next ./apps/web/.next

# Drop privileges. node:22-bookworm-slim ships a `node` user (uid 1000).
# Match the API image's uid 1001 / groupadd pattern so a shared volume
# mounted by both containers has consistent ownership. (10-M9: the
# previous comment claimed uid 1000 — that was wrong; the API image
# uses 1001. Pin the same uid here.)
RUN groupadd --system --gid 1001 nodejs 2>/dev/null || true \
    && useradd --system --uid 1001 --gid nodejs --create-home --shell /bin/bash node 2>/dev/null || true \
    && chown -R node:nodejs /app

USER node

EXPOSE 3000

# Healthcheck hits the Next.js root. If you add a /api/health route
# later, switch HEALTHCHECK_PATH to "/api/health".
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:3000/ >/dev/null 2>&1 || exit 1

CMD ["pnpm", "start:web"]
